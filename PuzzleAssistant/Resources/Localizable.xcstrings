    "Проведіть пальцем по картині, щоб виділити ділянку, яку збираєте зараз.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag your finger over the picture to select the area you are assembling now."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите пальцем по картине, чтобы выделить участок, который собираете сейчас."
          }
        }
      }
    },
    "Пропущений шматок можна додати дотиком, а зайвий — видалити.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a missed piece with a tap, or delete a wrong one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущенную деталь можно добавить касанием, а лишнюю — удалить."
          }
        }
      }
    },
    "Підходять до ділянки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit this area"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходят к участку"
          }
        }
