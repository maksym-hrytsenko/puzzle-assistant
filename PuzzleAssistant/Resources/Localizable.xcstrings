    "Сфотографувати": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографировать"
          }
        }
      }
    },
    "Сфотографувати шматки для ділянки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph pieces for this area"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографировать детали для участка"
          }
        }
      }
    },
    "Сфотографуйте всю картинку рівно, без відблисків": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the whole picture straight on, without glare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте всю картинку ровно, без бликов"
          }
        }
      }
    },
    "Сфотографуйте купку шматків — я перевірю кожен і підсвічу ті, що належать до цієї ділянки. Можна зробити кілька фото.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a pile of pieces — I’ll check each one and highlight those that belong to this area. You can take several photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте кучку деталей — я проверю каждую и подсвечу те, что относятся к этому участку. Можно сделать несколько фото."
          }
        }
      }
    },
    "Сфотографуйте розкидані шматки й торкніться будь-якого": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph loose pieces and tap any of them"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте разбросанные детали и коснитесь любой"
          }
        }
      }
    },
    "Сфотографуйте розкидані шматки — знайдені для цієї ділянки з'являться тут.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph loose pieces — those found for this area will appear here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте разбросанные детали — найденные для этого участка появятся здесь."
          }
        }
      }
    },
    "Сітка %lld × %lld = %lld клітинок": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid %lld × %lld = %lld cells"
          }
