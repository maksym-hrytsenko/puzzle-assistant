{
  "sourceLanguage": "uk",
  "version": "1.0",
  "strings": {
    "%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld %% ширини, %lld %% висоти · збіг %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% across, %lld %% down · match %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% ширины, %lld %% высоты · совпадение %@"
          }
        }
      }
    },
    "%lld фото": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld photos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld фото"
          }
        }
      }
    },
    "%lld шматків": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pieces"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld деталей"
          }
        }
      }
    },
    "(через одну клітинку)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(one cell apart)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "(через одну клетку)"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "«%@» додано: %lld фото шматків, %lld ділянок.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” added: %lld photos of pieces, %lld areas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» добавлен: %lld фото деталей, %lld участков."
          }
        }
      }
    },
    "«%@» оновлено: нових фото %lld, ділянок %lld, покладених шматків %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” updated: %lld new photos, %lld areas, %lld pieces placed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» обновлён: новых фото %lld, участков %lld, уложенных деталей %lld."
          }
        }
      }
    },
    "Інше фото": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another photo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое фото"
          }
        }
      }
    },
    "Весь кадр": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole frame"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь кадр"
          }
        }
      }
    },
    "Видалити": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Виділіть частину картини — знайду шматки саме для неї": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select part of the picture — I’ll find pieces for exactly that part"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите часть картины — найду детали именно для неё"
          }
        }
      }
    },
    "Вирівнюю картинку…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straightening the picture…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выравниваю картинку…"
          }
        }
      }
    },
    "Вирівняна": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straightened"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выровненная"
          }
        }
      }
    },
    "Вирівняти": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straighten"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выровнять"
          }
        }
