    "Готово": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Готую фото…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the photo…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовлю фото…"
          }
        }
      }
    },
    "Де він лежить?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where is it?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где она лежит?"
          }
        }
      }
    },
    "Де місце?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где место?"
          }
        }
      }
    },
    "Де цей шматок?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where does it go?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где эта деталь?"
          }
        }
      }
    },
    "Додати": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Дозвольте доступ до камери в Параметрах, щоб фотографувати пазл.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to photograph your puzzle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере в Настройках, чтобы фотографировать пазл."
          }
        }
      }
    },
    "Ділянка %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участок %lld"
          }
        }
      }
    },
    "Ділянка «%@»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участок «%@»"
          }
        }
      }
    },
    "Ділянки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Areas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участки"
          }
        }
      }
    },
    "З галереї": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From library"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из галереи"
          }
        }
      }
    },
    "Завантажте готову картинку пазла й вкажіть кількість шматків. Потім фотографуйте розкидані шматки — застосунок покаже, де кожен з них лежить на картині.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the finished puzzle picture and the number of pieces. Then photograph loose pieces — the app shows where each of them belongs on the picture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите готовую картинку пазла и укажите количество деталей. Затем фотографируйте разбросанные детали — приложение покажет, где каждая из них находится на картине."
          }
        }
      }
    },
    "Закрийте застосунок (змахніть його вгору в перемикачі програм) і відкрийте знову — інтерфейс буде новою мовою.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app (swipe it up in the app switcher) and open it again — the interface will be in the new language."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте приложение (смахните его вверх в переключателе программ) и откройте снова — интерфейс будет на новом языке."
          }
        }
      }
    },
    "Збирати крок за кроком (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemble step by step (%lld)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирать шаг за шагом (%lld)"
          }
        }
      }
    },
    "Збираємо «%@»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assembling “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собираем «%@»"
          }
        }
      }
    },
    "Знайдено шматків: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieces found: %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдено деталей: %lld"
          }
        }
      }
    },
    "Знайти місця шматків": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find where pieces go"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти места деталей"
          }
        }
      }
    },
    "Зупинити": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить"
          }
        }
      }
    },
    "Зібрати ділянку": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemble an area"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собрать участок"
          }
        }
      }
    },
    "Кладіть ліворуч від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it to the left of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите слева от детали из шага %lld."
          }
        }
      }
    },
    "Кладіть над шматком з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it above the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите над деталью из шага %lld."
          }
        }
      }
    },
    "Кладіть по діагоналі: вище й лівіше від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it diagonally: above and to the left of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите по диагонали: выше и левее детали из шага %lld."
          }
        }
      }
    },
    "Кладіть по діагоналі: вище й правіше від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it diagonally: above and to the right of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите по диагонали: выше и правее детали из шага %lld."
          }
        }
      }
    },
    "Кладіть по діагоналі: нижче й лівіше від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it diagonally: below and to the left of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите по диагонали: ниже и левее детали из шага %lld."
          }
        }
      }
    },
    "Кладіть по діагоналі: нижче й правіше від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it diagonally: below and to the right of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите по диагонали: ниже и правее детали из шага %lld."
          }
        }
      }
    },
    "Кладіть поруч зі шматком з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it next to the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите рядом с деталью из шага %lld."
          }
        }
      }
    },
    "Кладіть праворуч від шматка з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it to the right of the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите справа от детали из шага %lld."
          }
        }
      }
    },
    "Кладіть під шматком з кроку %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place it below the piece from step %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладите под деталью из шага %lld."
          }
        }
      }
    },
    "Крок %lld з %lld": {
      "localizations": {
