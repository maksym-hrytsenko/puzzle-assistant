          }
        }
      }
    },
    "Торкніться погано обведеного шматка, щоб прибрати його": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a badly outlined piece to remove it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь плохо обведённой детали, чтобы убрать её"
          }
        }
      }
    },
    "Торкніться пропущеного шматка, щоб обвести його": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a missed piece to outline it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь пропущенной детали, чтобы обвести её"
          }
        }
      }
    },
    "Торкніться шматка — покажу, де він на картині": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a piece — I’ll show where it is on the picture"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь детали — покажу, где она на картине"
          }
        }
