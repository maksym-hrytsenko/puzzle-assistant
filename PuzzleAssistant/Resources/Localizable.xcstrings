          }
        }
      }
    },
    "Рівне світло без відблисків — так кольори ближчі до картини.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even light without glare — colours stay closer to the picture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровный свет без бликов — так цвета ближе к картине."
          }
