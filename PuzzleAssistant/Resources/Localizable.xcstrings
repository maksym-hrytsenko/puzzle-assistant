    "Підходять: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit: %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходят: %lld"
          }
        }
      }
    },
    "Рамку картинки не знайдено — використаю фото як є. Обріжте його заздалегідь, якщо поруч є стіл.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture edges not found — the photo is used as is. Crop it beforehand if the table is visible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамка картинки не найдена — использую фото как есть. Обрежьте его заранее, если рядом виден стол."
          }
        }
      }
    },
    "Режим": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим"
          }
        }
      }
    },
    "Розкладіть шматки картинкою догори, бажано не один на одному.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the pieces picture side up, preferably not on top of each other."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разложите детали картинкой вверх, желательно не друг на друге."
          }
        }
      }
    },
    "Рядки %@ · стовпці %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows %@ · columns %@"
