    },
    "Відбираю цілі шматки…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picking whole pieces…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбираю целые детали…"
          }
        }
