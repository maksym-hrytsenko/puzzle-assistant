    "Відкриваю пазл…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the puzzle…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открываю пазл…"
          }
        }
      }
    },
    "Галерея": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Галерея"
          }
        }
      }
    },
    "Готова картинка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished picture"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовая картинка"
          }
        }
